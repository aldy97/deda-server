# 应用基础配置
NODE_ENV=development
APP_PORT=3000
APP_NAME=deda-server

# 数据库配置（PostgreSQL）
# 环境说明
# - 本地开发：NODE_ENV=development，数据库/Redis 用本地或 Docker
# - 测试环境（staging）：NODE_ENV=staging，使用独立数据库/Redis，机芯厂对接测试环境
# - 生产环境（production）：NODE_ENV=production，使用独立数据库/Redis，机芯厂对接生产环境
# 禁止开发/测试环境连接生产数据库。

# 数据库配置（PostgreSQL）
# Docker Compose 中使用：postgresql://deda:${DB_PASSWORD}@postgres:5432/deda?schema=public
DATABASE_URL=postgresql://deda:deda_password@localhost:5432/deda?schema=public
DB_PASSWORD=deda_password

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# 微信小程序配置
# 本地开发时若未配置真实 AppSecret，server 会进入 mock 登录模式（任意 code 返回测试用户）
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# CORS 配置（本地开发可设为 *，生产设为小程序域名）
CORS_ORIGIN=*

# 机芯厂商 API 配置
MANUFACTURER_BASE_URL=https://api.manufacturer.example.com
MANUFACTURER_API_KEY=your-manufacturer-api-key
MANUFACTURER_WEBHOOK_SECRET=your-webhook-signing-secret

# MQTT 配置（机芯厂状态推送）
MQTT_URL=mqtt://localhost:1883
MQTT_STATUS_TOPIC=zhianxin/event/report

# ===== Phase 1 MVP：LLM / RAG（现阶段必填）=====
# LLM 提供商：openai / azure / deepseek / siliconflow / custom
# MVP 阶段请填 deepseek
LLM_PROVIDER=deepseek

# OpenAI 兼容 API 的 base URL（必填）
# MVP 阶段使用 DeepSeek：https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# API Key（必填，现阶段请填入你的 DeepSeek API Key）
OPENAI_API_KEY=

# 模型名称（必填，MVP 使用 DeepSeek-Flash）
OPENAI_MODEL=deepseek-flash

# ===== 首响「打哈哈」小模型（Qwen / 阿里云百炼 DashScope，OpenAI 兼容）=====
# 端点：北京地域如下；新加坡地域用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 未配置时回落主模型端点与 key，主链路仍可跑通
SMALL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 百炼 API Key（placeholder：本地填入真实 key 即跑通；灰度/生产在各环境注入同名变量）
SMALL_LLM_API_KEY=

# filler 选型：qwen-flash —— 千问 Flash 稳定别名，最快/最便宜档，中文好，支持 streaming
# 注意：勿改用 qwen3.x 版本号模型（默认开启思考模式，首 token 延迟高）；如必须使用需显式关闭 thinking
SMALL_LLM_MODEL=qwen-flash

# 双模型流式开关（可选，默认 true；设为 false 回落到非流式单模型路径）
LLM_STREAM_ENABLED=true

# 机芯厂回复上传 WS 地址（可选；我方按 chunk 流式调用该接口上传回复文字，机芯厂做 TTS 下发设备）
# 未配置时内部双模型编排照常运行，发送仅记 debug 日志（便于本地开发/测试）
# 鉴权暂未实现，接入时在 src/modules/vendor/vendor-reply.uploader.ts 补充
VENDOR_WS_UPLOAD_URL=

# 机芯厂上传 ack 超时（毫秒，可选，默认 5000）
VENDOR_UPLOAD_ACK_TIMEOUT_MS=5000

# 乙方云流量录制（可选，默认 off）：开启后 vendor 通道每条上行/下行原文带时间戳落盘
# records/vendor-YYYY-MM-DD.jsonl（按天轮转，启动时清理超保留期文件），用于联调追责的
# in/out 时间线对账。录制文件已被 .gitignore 排除。写盘失败只 warn，不影响对话链路。
VENDOR_TRAFFIC_RECORD=off
# 录制目录（可选，默认 records）
VENDOR_TRAFFIC_RECORD_DIR=records
# 保留天数（可选，默认 7）
VENDOR_TRAFFIC_RECORD_RETENTION_DAYS=7

# 请求超时（毫秒，可选，默认 30000）
LLM_TIMEOUT_MS=30000

# 默认教材与单元（MVP 阶段若请求未传则使用）
DEFAULT_TEXTBOOK_ID=sample-textbook
DEFAULT_UNIT_ID=unit-1

# 教材 JSON 数据目录（可选，默认自动推断）
# TEXTBOOK_DATA_DIR=/app/data/textbooks

# 日志配置
LOG_LEVEL=info
