# 应用基础配置
NODE_ENV=development
APP_PORT=3000
APP_NAME=deda-server

# 数据库配置（PostgreSQL）
# 环境说明
# - 本地开发：NODE_ENV=development，数据库/Redis 用本地或 Docker
# - 测试环境（staging）：NODE_ENV=staging，使用独立数据库/Redis，机芯厂对接测试环境
# - 生产环境（production）：NODE_ENV=production，使用独立数据库/Redis，机芯厂对接生产环境
# 禁止开发/测试环境连接生产数据库。

# 数据库配置（PostgreSQL）
# Docker Compose 中使用：postgresql://deda:${DB_PASSWORD}@postgres:5432/deda?schema=public
DATABASE_URL=postgresql://deda:deda_password@localhost:5432/deda?schema=public
DB_PASSWORD=deda_password

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Analytics Dashboard 管理员鉴权（内部，独立于小程序 JWT）
ANALYTICS_JWT_SECRET=your-analytics-jwt-secret-change-in-production
ANALYTICS_JWT_EXPIRES_IN=12h
# 管理员白名单（JSON 数组）：[{"username":"admin","salt":"<hex>","passwordHash":"<hex>","displayName":"管理员"}]
# 生成 salt/hash：node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s, c.scryptSync('你的密码',s,64).toString('hex'))"
ANALYTICS_ADMIN_USERS=[]

# ARMS 应用监控（可选）：不配 ARMS_LICENSE_KEY 则探针不加载，服务原样启动
# LicenseKey 从 ARMS 控制台「接入中心」获取； staging/prod 用不同 APP_NAME 隔离
ARMS_APP_NAME=
ARMS_REGION_ID=cn-shanghai
ARMS_LICENSE_KEY=

# deda-dashboard SPA 静态产物目录（可选；目录存在时由本服务托管到 /dashboard）
# 本地开发指向 deda-dashboard 仓库的 dist；服务器上由 compose 固定为 /opt/deda/dashboard/{staging,prod}
DASHBOARD_DIST_PATH=

# 微信小程序配置
# 本地开发时若未配置真实 AppSecret，server 会进入 mock 登录模式（任意 code 返回测试用户）
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# CORS 配置（本地开发可设为 *，生产设为小程序域名）
CORS_ORIGIN=*

# 机芯厂商 API 配置
MANUFACTURER_BASE_URL=https://api.manufacturer.example.com
MANUFACTURER_API_KEY=your-manufacturer-api-key
MANUFACTURER_WEBHOOK_SECRET=your-webhook-signing-secret

# MQTT 配置（机芯厂状态推送）
MQTT_URL=mqtt://localhost:1883
MQTT_STATUS_TOPIC=zhianxin/event/report

# LLM 适配层（百度 RTC 回调 /v1/chat/completions 的入站 Bearer token）
# 该值同时作为 client-api loginMac 响应头 Authorization 返回给设备（三方 LLM API KEY）
LLM_ADAPTER_API_KEY=

# 机芯厂设备侧接口（/client/**，src/modules/client-api）
# 设备上线密码共享密钥：password = md5_ascii(md5_utf8(DEVICE_LOGIN_MAC_KEY + mac))
DEVICE_LOGIN_MAC_KEY=
# 配网认领窗口（秒）：loginMac 上线后该时长内可被小程序认领绑定，默认 120
PROVISION_CLAIM_WINDOW_SEC=120

# ===== LLM 配置（现阶段必填）=====
# LLM 提供商：openai / azure / deepseek / siliconflow / custom
# MVP 阶段请填 deepseek
LLM_PROVIDER=deepseek

# OpenAI 兼容 API 的 base URL（必填）
# MVP 阶段使用 DeepSeek：https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# API Key（必填，现阶段请填入你的 DeepSeek API Key）
OPENAI_API_KEY=

# 模型名称（必填，MVP 使用 DeepSeek-Flash）
OPENAI_MODEL=deepseek-flash

# ===== 首响「打哈哈」小模型（Qwen / 阿里云百炼 DashScope，OpenAI 兼容）=====
# 端点：北京地域如下；新加坡地域用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 未配置时回落主模型端点与 key，主链路仍可跑通
SMALL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 百炼 API Key（placeholder：本地填入真实 key 即跑通；灰度/生产在各环境注入同名变量）
SMALL_LLM_API_KEY=

# filler 选型：qwen-flash —— 千问 Flash 稳定别名，最快/最便宜档，中文好，支持 streaming
# 注意：勿改用 qwen3.x 版本号模型（默认开启思考模式，首 token 延迟高）；如必须使用需显式关闭 thinking
SMALL_LLM_MODEL=qwen-flash

# 双模型流式开关（可选，默认 true；设为 false 回落到非流式单模型路径）
LLM_STREAM_ENABLED=true

# 机芯厂回复上传 WS 地址（可选；我方按 chunk 流式调用该接口上传回复文字，机芯厂做 TTS 下发设备）
# 未配置时内部双模型编排照常运行，发送仅记 debug 日志（便于本地开发/测试）
# 鉴权暂未实现，接入时在 src/modules/vendor/vendor-reply.uploader.ts 补充
VENDOR_WS_UPLOAD_URL=

# 机芯厂上传 ack 超时（毫秒，可选，默认 5000）
VENDOR_UPLOAD_ACK_TIMEOUT_MS=5000

# 乙方云流量录制（可选，默认 off）：开启后 vendor 通道每条上行/下行原文带时间戳落盘
# records/vendor-YYYY-MM-DD.jsonl（按天轮转，启动时清理超保留期文件），用于联调追责的
# in/out 时间线对账。录制文件已被 .gitignore 排除。写盘失败只 warn，不影响对话链路。
VENDOR_TRAFFIC_RECORD=off
# 录制目录（可选，默认 records）
VENDOR_TRAFFIC_RECORD_DIR=records
# 保留天数（可选，默认 7）
VENDOR_TRAFFIC_RECORD_RETENTION_DAYS=7

# 请求超时（毫秒，可选，默认 30000）
LLM_TIMEOUT_MS=30000

# 日志配置
LOG_LEVEL=info

# 定时进入哄睡（可选，默认关）：开启后每分钟扫描 enabled=true 的哄睡配置，
# 北京时间到达 sleepTime 时经 Vendor WS 下行哄睡故事。每设备每天最多触发一次，
# 设备离线跳过当天不补发；song/mixed 在儿歌内容源上线前降级为故事。
SLEEP_SCHEDULER_ENABLED=false

# 哄睡服务通知推送（可选，默认关）：开启后到点向设备所有绑定家长推送
# 微信订阅消息（与设备在线状态解耦）。依赖上方 WECHAT_APPID/SECRET。
PUSH_NOTIFICATIONS_ENABLED=false
# 哄睡提醒订阅消息模板 ID（微信公众平台申请；未配置时上报接口一律 400、推送不发送）
WECHAT_TMPL_SLEEP_REMINDER=

# ─── 阿里云账单（LLM 费用看板）───────────────────────────────────────────────
# 小模型（百炼 qwen-flash）金额以阿里云 BSS 真实账单为真值，由 BillingSyncService 落库 llm_cost_daily。
# 凭证二选一，全部留空则接口降级为「未接入阿里云账单」（页面显示占位，不显示 ¥0）。
#
# 生产建议：不给 AK/SK，改在 ECS 上绑一个只读实例 RAM 角色（权限仅 bssapi:DescribeInstanceBill），
# 走默认凭证链从元数据服务取临时 STS 凭证——密钥不落盘、自动轮转，compose 里也不需要放任何密钥
# （docker/docker-compose.yml 的 environment 白名单已放行下列全部变量，只需在 env 文件里给值）。
# 本地/staging 才用下面的 AK/SK（子账号，只授 bssapi:DescribeInstanceBill）。
ALIYUN_BSS_ACCESS_KEY_ID=
ALIYUN_BSS_ACCESS_KEY_SECRET=
# 走 ECS 实例 RAM 角色时设为 true（AK/SK 留空）
ALIYUN_BSS_USE_RAM_ROLE=

# 百炼的 ProductCode（可选）。留空则不按产品过滤、拉全账号账单行；
# 首次接入用 `npx ts-node -r tsconfig-paths/register scripts/backfill-aliyun-bill.ts --probe` 探测后固化。
ALIYUN_BSS_PRODUCT_CODE=
# BSS 接入点（可选，默认 business.aliyuncs.com；海外站为 business.ap-southeast-1.aliyuncs.com）
ALIYUN_BSS_ENDPOINT=

# 账单同步开关（可选，默认 false）。开启后 onModuleInit 补拉一次并每 LLM_COST_SYNC_INTERVAL_MINUTES 分钟重拉。
LLM_COST_SYNC_ENABLED=false
# 同步间隔分钟（可选，默认 360＝6 小时；上限 1440）
LLM_COST_SYNC_INTERVAL_MINUTES=360
# 每轮回溯天数（可选，默认 3）：账单延迟 24h 出账、当月还会退款/调账，故近几天需反复覆盖；上限 62
LLM_COST_SYNC_LOOKBACK_DAYS=3
