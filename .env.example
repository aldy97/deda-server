# 应用基础配置
#
# ⚠️ 容器部署必读：docker/docker-compose.yml 的 app.environment 是**白名单**。
# compose 没有用 env_file，`--env-file` 只做 ${VAR} 文本替换，不会把变量注入容器。
# 在本文件加了新变量却没同步进那份白名单 → 容器里读到的永远是 undefined，
# 且不报错，只静默走代码默认值。白名单口径由
# src/common/workflows/compose-env-gate.spec.ts 钉住，漏了 CI 会红。
NODE_ENV=development
APP_PORT=3000
APP_NAME=deda-server
# V8 老生代上限（MB）。Node 按**宿主机**总内存推算它、不看 cgroup limit，
# 所以容器内不显式限定就会在 GC 触发前被 OOM kill（退出码 137，日志里没有堆溢出记录）。
# staging/prod 由 docker-compose.{staging,prod}.yml 硬写（768 / 1024，与各自 memory
# limit 配套），在 env 文件里设**无效**——override 会覆盖 base。
# 只有本地 docker compose（override.yml）或裸跑 node 时才需要自己设。
#NODE_OPTIONS=--max-old-space-size=1024

# 数据库配置（PostgreSQL）
# 环境说明
# - 本地开发：NODE_ENV=development，数据库/Redis 用本地或 Docker
# - 测试环境（staging）：NODE_ENV=staging，使用独立数据库/Redis，机芯厂对接测试环境
# - 生产环境（production）：NODE_ENV=production，使用独立数据库/Redis，机芯厂对接生产环境
# 禁止开发/测试环境连接生产数据库。

# 数据库配置（PostgreSQL）
# Docker Compose 中使用：postgresql://deda:${DB_PASSWORD}@postgres:5432/deda?schema=public
DATABASE_URL=postgresql://deda:deda_password@localhost:5432/deda?schema=public
DB_PASSWORD=deda_password

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Analytics Dashboard 管理员鉴权（内部，独立于小程序 JWT）
ANALYTICS_JWT_SECRET=your-analytics-jwt-secret-change-in-production
ANALYTICS_JWT_EXPIRES_IN=7d
# 管理员白名单（JSON 数组）：[{"username":"admin","salt":"<hex>","passwordHash":"<hex>","displayName":"管理员"}]
# 生成 salt/hash：node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s, c.scryptSync('你的密码',s,64).toString('hex'))"
# 可选 scopes：声明专项能力。缺省等于 ["analytics"]（只能看看板）。
# 内容创作者写：{"username":"author",...,"scopes":["analytics","adventure-content"]}
# 注意：scopes 决定「这个人能不能碰」，CONTENT_ADMIN_PROFILE 决定「这个环境让不让写」，两者都满足才放行。
ANALYTICS_ADMIN_USERS=[]

# ── 冒险内容管理台（Adventure Studio）──────────────────────────────────────
# 本环境是否允许写内容：authoring / readonly。
# 缺省与拼错一律按 readonly 处理（fail-safe）——prod 请不要设置这个变量。
# staging 由 docker/docker-compose.staging.yml 设为 authoring。
CONTENT_ADMIN_PROFILE=
# 内容校验阈值（全部可选，留空用代码内默认值）
#ADVENTURE_LINT_MAX_INTERACTION_CHARS=60
#ADVENTURE_LINT_MAX_NARRATION_CHARS=120
#ADVENTURE_LINT_MAX_TITLE_CHARS=40
#ADVENTURE_LINT_MAX_STARS_PER_EPISODE=5
#ADVENTURE_LINT_MIN_CHOICE_TEXT_CHARS=2
# 禁用词，逗号分隔（中英文逗号都认）；命中连草稿都不许保存
#ADVENTURE_LINT_FORBIDDEN_WORDS=
# 试播时长估算阈值（可选）
#ADVENTURE_SIM_MAX_AWAIT_POINTS=12
#ADVENTURE_SIM_MAX_SESSION_SECONDS=900

# ── 冒险自愈与兜底（L3 熔断器 / L4 巡检）────────────────────────────────────
# 总开关。关掉后巡检不启动、不注册引擎失败监听，且**手动触发巡检也会被拒**
# （能被 API 绕过的开关不是开关）。默认开。
#ADVENTURE_RECOVERY_ENABLED=true
# 巡检周期。60s：比引擎自身的 2s 超时扫描慢一个量级，避免抢跑
#ADVENTURE_RECOVERY_SWEEP_INTERVAL_MS=60000
# 「等待互动但 waitingSince 为空」判定为陈旧所需的静默时长，仅在下一项非 off 时生效
#ADVENTURE_RECOVERY_STALE_AWAIT_MS=120000
# 陈旧等待态的处置：off（默认，完全不扫）/ alert（只告警）/ exit（改判 exited）。
# 默认 off 是硬要求：主链路（百度 RTC）刻意不落 waitingSince，孩子停在互动点
# 可能一停几小时，改判 exited 会让下一句「我选第二个」掉进意图分类变成闲聊。
# 只有纯 vendor 链路（有 10s 沉默超时推送）的部署才应该开 alert/exit。
#ADVENTURE_RECOVERY_STALE_AWAIT_ACTION=off
# 熔断滑动窗口长度 / 窗口内失败达到此数即熔断（只标记 + 告警，绝不自动改内容）
#ADVENTURE_BREAKER_WINDOW_MS=600000
#ADVENTURE_BREAKER_THRESHOLD=5
# 熔断标记的存活时间；过期后若窗口内仍超阈值会重新熔断并再次告警
#ADVENTURE_BREAKER_TRIPPED_TTL_SECONDS=3600

# ── 冒险二选一 LLM 兜底判定 ────────────────────────────────────────
# 默认关。播放内容来自版本快照有版本号保护，但匹配算法无版本快照保护，
# 改动对正在玩的孩子立刻生效 —— 此开关是唯一能不发版就止血的机制。
# 灰度验证通过后设为字面 "true" 打开。
#ADVENTURE_CHOICE_LLM_ENABLED=false

# ── 测试冒险故事下发（仅 staging）──────────────────────────────────
# 总开关，字面 "true" 才启用。开启后孩子说「测试冒险故事」即播放看板下发到该
# 设备的集，不限次数/顺序、可播草稿快照。刻意不进 base/prod 的白名单
# （compose-env-gate.spec.ts 钉死），只有 staging override 硬写 'true'；
# 本地联调时在 .env 里自行打开。未开启时引擎行为与关掉完全一致（fail-safe）。
#ADVENTURE_TEST_MODE_ENABLED=false

# ARMS 应用监控（可选）：不配 ARMS_LICENSE_KEY 则探针不加载，服务原样启动
# LicenseKey 从 ARMS 控制台「接入中心」获取； staging/prod 用不同 APP_NAME 隔离
ARMS_APP_NAME=
ARMS_REGION_ID=cn-shanghai
ARMS_LICENSE_KEY=

# deda-dashboard SPA 静态产物目录（可选；目录存在时由本服务托管到 /dashboard）
# 本地开发指向 deda-dashboard 仓库的 dist；服务器上由 compose 固定为 /opt/deda/dashboard/{staging,prod}
DASHBOARD_DIST_PATH=

# 微信小程序配置
# 本地开发时若未配置真实 AppSecret，server 会进入 mock 登录模式（任意 code 返回测试用户）
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# CORS 配置（本地开发可设为 *，生产设为小程序域名）
CORS_ORIGIN=*

# 机芯厂商 API 配置
MANUFACTURER_BASE_URL=https://api.manufacturer.example.com
MANUFACTURER_API_KEY=your-manufacturer-api-key
MANUFACTURER_WEBHOOK_SECRET=your-webhook-signing-secret

# MQTT 配置（机芯厂状态推送）
MQTT_URL=mqtt://localhost:1883
MQTT_STATUS_TOPIC=zhianxin/event/report
# 设备状态在 Redis 里的存活秒数（可选，默认 300）。心跳 5s 一次，键过期即视为掉线：
# 调大能让弱网设备少抖动，调小则在线状态更实时。
#MQTT_STATUS_TTL_SECONDS=300

# LLM 适配层（百度 RTC 回调 /v1/chat/completions 的入站 Bearer token）
# 该值同时作为 client-api loginMac 响应头 Authorization 返回给设备（三方 LLM API KEY）
LLM_ADAPTER_API_KEY=
# 流式「打哈哈」filler 开关（可选，默认开）。只认字面小写 false 关闭——
# 关掉后首音延迟退回「等整句生成完」，且缺失轮不再有防死空气缓冲；
# 拼错的值（FALSE / 0 / no）不会静默关闭，仍按开处理。
#LLM_ADAPTER_FILLER=false

# 机芯厂设备侧接口（/client/**，src/modules/client-api）
# 设备上线密码共享密钥：password = md5_ascii(md5_utf8(DEVICE_LOGIN_MAC_KEY + mac))
DEVICE_LOGIN_MAC_KEY=
# 配网认领窗口（秒）：loginMac 上线后该时长内可被小程序认领绑定，默认 120
PROVISION_CLAIM_WINDOW_SEC=120

# ===== LLM 配置（现阶段必填）=====
# LLM 提供商：openai / azure / deepseek / siliconflow / custom
# MVP 阶段请填 deepseek
LLM_PROVIDER=deepseek

# OpenAI 兼容 API 的 base URL（必填）
# MVP 阶段使用 DeepSeek：https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# API Key（必填，现阶段请填入你的 DeepSeek API Key）
OPENAI_API_KEY=

# 模型名称（必填，MVP 使用 DeepSeek-Flash）
OPENAI_MODEL=deepseek-flash

# ===== 首响「打哈哈」小模型（Qwen / 阿里云百炼 DashScope，OpenAI 兼容）=====
# 端点：北京地域如下；新加坡地域用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 未配置时回落主模型端点与 key，主链路仍可跑通
SMALL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 百炼 API Key（placeholder：本地填入真实 key 即跑通；灰度/生产在各环境注入同名变量）
SMALL_LLM_API_KEY=

# filler 选型：qwen-flash —— 千问 Flash 稳定别名，最快/最便宜档，中文好，支持 streaming
# 注意：勿改用 qwen3.x 版本号模型（默认开启思考模式，首 token 延迟高）；如必须使用需显式关闭 thinking
# 代码对小模型请求固定下发 enable_thinking=false（qwen-flash 本身默认非思考，双保险）
SMALL_LLM_MODEL=qwen-flash

# 双模型流式开关（可选，默认 true；设为 false 回落到非流式单模型路径）
LLM_STREAM_ENABLED=true

# 机芯厂回复上传 WS 地址（可选；我方按 chunk 流式调用该接口上传回复文字，机芯厂做 TTS 下发设备）
# 未配置时内部双模型编排照常运行，发送仅记 debug 日志（便于本地开发/测试）
# 鉴权暂未实现，接入时在 src/modules/vendor/vendor-reply.uploader.ts 补充
VENDOR_WS_UPLOAD_URL=

# 机芯厂上传 ack 超时（毫秒，可选，默认 5000）
VENDOR_UPLOAD_ACK_TIMEOUT_MS=5000

# 乙方云流量录制（可选，默认 off）：开启后 vendor 通道每条上行/下行原文带时间戳落盘
# records/vendor-YYYY-MM-DD.jsonl（按天轮转，启动时清理超保留期文件），用于联调追责的
# in/out 时间线对账。录制文件已被 .gitignore 排除。写盘失败只 warn，不影响对话链路。
VENDOR_TRAFFIC_RECORD=off
# 录制目录（可选，默认 records）
VENDOR_TRAFFIC_RECORD_DIR=records
# 保留天数（可选，默认 7）
VENDOR_TRAFFIC_RECORD_RETENTION_DAYS=7

# 请求超时（毫秒，可选，默认 30000）
LLM_TIMEOUT_MS=30000

# 日志配置
LOG_LEVEL=info

# 定时进入哄睡（可选，默认关）：开启后每分钟扫描 enabled=true 的哄睡配置，
# 北京时间到达 sleepTime 时经 Vendor WS 下行哄睡故事。每设备每天最多触发一次，
# 设备离线跳过当天不补发；song/mixed 在儿歌内容源上线前降级为故事。
SLEEP_SCHEDULER_ENABLED=false

# 哄睡服务通知推送（可选，默认关）：开启后到点向设备所有绑定家长推送
# 微信订阅消息（与设备在线状态解耦）。依赖上方 WECHAT_APPID/SECRET。
PUSH_NOTIFICATIONS_ENABLED=false
# 哄睡提醒订阅消息模板 ID（微信公众平台申请；未配置时上报接口一律 400、推送不发送）
WECHAT_TMPL_SLEEP_REMINDER=

# ─── 阿里云账单（LLM 费用看板）───────────────────────────────────────────────
# 小模型（百炼 qwen-flash）金额以阿里云 BSS 真实账单为真值，由 BillingSyncService 落库 llm_cost_daily。
# 凭证二选一，全部留空则接口降级为「未接入阿里云账单」（页面显示占位，不显示 ¥0）。
#
# 生产建议：不给 AK/SK，改在 ECS 上绑一个只读实例 RAM 角色（权限仅 bssapi:DescribeInstanceBill），
# 走默认凭证链从元数据服务取临时 STS 凭证——密钥不落盘、自动轮转，compose 里也不需要放任何密钥
# （docker/docker-compose.yml 的 environment 白名单已放行下列全部变量，只需在 env 文件里给值）。
# 本地/staging 才用下面的 AK/SK（子账号，只授 bssapi:DescribeInstanceBill）。
ALIYUN_BSS_ACCESS_KEY_ID=
ALIYUN_BSS_ACCESS_KEY_SECRET=
# 走 ECS 实例 RAM 角色时设为 true（AK/SK 留空）
ALIYUN_BSS_USE_RAM_ROLE=

# 百炼的 ProductCode（可选）。留空则不按产品过滤、拉全账号账单行；
# 首次接入用 `npx ts-node -r tsconfig-paths/register scripts/backfill-aliyun-bill.ts --probe` 探测后固化。
ALIYUN_BSS_PRODUCT_CODE=
# BSS 接入点（可选，默认 business.aliyuncs.com；海外站为 business.ap-southeast-1.aliyuncs.com）
ALIYUN_BSS_ENDPOINT=

# 账单同步开关（可选，默认 false）。开启后 onModuleInit 补拉一次并每 LLM_COST_SYNC_INTERVAL_MINUTES 分钟重拉。
LLM_COST_SYNC_ENABLED=false
# 同步间隔分钟（可选，默认 360＝6 小时；上限 1440）
LLM_COST_SYNC_INTERVAL_MINUTES=360
# 每轮回溯天数（可选，默认 3）：账单延迟 24h 出账、当月还会退款/调账，故近几天需反复覆盖；上限 62
LLM_COST_SYNC_LOOKBACK_DAYS=3

# ─── Prompt 注册表（dashboard 后台 view / edit / publish）─────────────────────
# 发布确认码（可选，默认 DEDA2025）。dashboard 发布/回滚/恢复默认弹窗要求管理员
# **手动输入**，服务端用 timingSafeEqual 校验；前端弹窗只是提醒，不构成安全边界。
# 注意：docker/docker-compose.yml 的 environment 是白名单且没有 env_file，
# 想在容器内覆盖此值，必须同时把它加进那份白名单，否则一律走代码默认值。
PROMPT_PUBLISH_CONFIRM_CODE=DEDA2025
# 写开关（可选，默认开）。设为字面 false（大小写不敏感）时 dashboard 只能查看，
# 草稿 / 发布 / 回滚 / 恢复默认一律 403。只认字面 false：打错的值不会静默禁写。
PROMPT_WRITE_ENABLED=true

# ─── 音色/语速动态切换（百度云大模型实时互动控制面）──────────────────────────
# 总开关。默认 false（暗启动）：设为 true 前必须先填好 VOICE_CATALOG_JSON，
# 否则 POST /device-configs/:deviceId/voice 始终返回 applied="deferred" +
# reason="empty_catalog"，不会调用百度云。
BAIDU_AGENT_ENABLED=false

# 百度云出站请求超时（毫秒），默认 5000。
BAIDU_AGENT_TIMEOUT_MS=5000

# 音色目录（JSON 数组）。placeholder，权威来源是百度 GET /api/v1/timbres
# （文档：https://cloud.baidu.com/doc/RTC/s/Umh4lwjxt），但我方无百度 AK/SK、
# 设备也未为该操作签名，无法自动同步，需机芯公司从百度导出后填入。
# 元素形如 {"timbreId":"1000063","name":"度小熊","status":"TRAINED","language":"chinese"}。
# 注意 .env 里写 JSON 必须保持单行。
VOICE_CATALOG_JSON=[]

# 语速（非哄睡 + 哄睡两个倍数）已迁入 DB（voice_speed_config 表，管理端 /analytics/voice-speed 读写）。
# 不再走 env；getvalue 每轮实时查表，未命中档位回落基础语速 1.0。

# getvalue 响应体 vol（TTS 合成音量倍数）的唯一来源，全局配置、不做每设备可调。
# 合法范围 [0.5, 2.0]（v1.4 §4.2）；未配置时取 1.0。
# 与 MQTT 的本地 volume（0-100）互不影响：本值只进百度 TTS 合成，不改设备播放音量。
# 非法或越界 → getvalue 一律返回 500，设备按 §4.3 停止本轮创建（不裁剪、不兜底），
# 因此改这个值等于改全量设备的可用性，改前先确认在范围内。
TTS_DEFAULT_VOL=1.0

# IP/角色（Device.characterKey，取值 elly / polly）→ timbreId 权威映射（JSON 对象）。
# 产品定义：一个机芯对应一个 IP，一个 IP 只有一个专属音色，家长端不选择音色。
# 本映射是平台侧「某个 IP 用哪个音色」的唯一真相，两个消费方：
#   1. 设备端协议 v1.4（2026-11-18）新增的 POST /client/bot/bot/getvalue——固件每轮
#      创建百度实例前拉取 vcn/vol/spd 且不缓存，vcn 即取自这里
#      （实现见 ClientApiService.botGetValue）；
#   2. 冒险剧情内多 IP 同剧时按角色切音色（switchSceneRole，未接入，见 Q16）。
# 为空时查表一律返回 null，此时 getvalue 返回 500（不编兜底音色：错的音色不会
# 被任何人察觉，500 至少在服务端日志里留下可归因的原因）。
# 示例：{"elly":"1000063","polly":"1000064"}
# TODO(Q1): **取值已定、尚未填入任何环境**（熊总 2026-11-19）——Elly/Polly 暂不区分
# 专属音色，两个 IP 先统一用 v1.4 文档示例里的 1000957，即
# {"elly":"1000957","polly":"1000957"}；日后拿到各 IP 的专属音色，只改本映射里对应
# 的一行即可切换（getvalue 每轮查表、固件不缓存，代码零改动）。
# 音色目录 VOICE_CATALOG_JSON 本次不覆盖：它是百度侧目录快照，不是 getvalue 的数据源。
# **这是固件升级到 v1.4 的发布闸口**：env 未填好之前设备每轮对话都会在 getvalue 失败、
# 无法创建实例。另注意填了 env 文件还不够——本键必须在 docker/docker-compose.yml 的
# environment 白名单里转发才会进容器（compose-env-gate.spec.ts 已把这组键钉住）。
CHARACTER_TIMBRE_JSON={}
