# 应用基础配置
NODE_ENV=development
APP_PORT=3000
APP_NAME=deda-server

# 数据库配置（PostgreSQL）
DATABASE_URL=postgresql://deda:deda_password@localhost:5432/deda_db?schema=public

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# 微信小程序配置
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# 机芯厂商 API 配置
MANUFACTURER_BASE_URL=https://api.manufacturer.example.com
MANUFACTURER_API_KEY=your-manufacturer-api-key
MANUFACTURER_WEBHOOK_SECRET=your-webhook-signing-secret

# 日志配置
LOG_LEVEL=info
