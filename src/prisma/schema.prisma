// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 家长账号
model User {
  id            String    @id @default(uuid())
  openid        String    @unique // 微信小程序 openid
  phone         String?   @unique // 手机号，可选绑定
  nickname      String?   // 微信昵称
  avatarUrl     String?   // 头像
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bindings              UserDeviceBinding[]
  childProfiles         ChildProfile[]
  feedbacks             Feedback[]
  parentReportFeedbacks ParentReportFeedback[]
  pushSubscriptions     PushSubscription[]

  @@map("users")
}

// 用户反馈：删除用户时保留反馈，并清空历史反馈的用户关联。
model Feedback {
  id        String   @id
  userId    String?  @map("user_id")
  content   String
  contact   String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("feedbacks")
}

// 设备信息
model Device {
  id              String   @id @default(uuid())
  deviceId        String   @unique // 厂商侧设备唯一编号
  characterKey    String   @default("elly") // 默认 IP：elly / polly
  deviceCode      String?  @unique // 设备编码（展示用）
  firmwareVersion String?  // 固件版本
  wifiName        String?  // WiFi 名称
  ipAddress       String?  // IP 地址
  networkType     String?  // 网络类型：4G / WiFi
  macAddress      String?  // MAC 地址
  subnetMask      String?  // 子网掩码
  gateway         String?  // 网关
  dns             String?  // DNS
  timezone        String?  // 时区
  topicAddress    String?  // 主题地址
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bindings        UserDeviceBinding[]
  configs         DeviceConfig[]
  messages        Message[]
  learningStats   LearningStat[]
  childProfile    ChildProfile?
  adventureProgresses AdventureProgress[]
  adventureDailyRecords AdventureDailyRecord[]
  adventureEvents AdventureEvent[]
  childMemories   ChildMemory[]
  parentReports   ParentReport[]
  habitPlans      HabitPlan[]
  conversationSession ConversationSession?
  sleepConfig     SleepConfig?
  llmUsageLogs    LlmUsageLog[]
  presenceDaily   DevicePresenceDaily[]

  @@map("devices")
}

// 每台设备的当前对话会话；冒险进度仍由 AdventureProgress 单独管理。
model ConversationSession {
  id          String    @id @default(uuid())
  deviceId    String    @unique
  currentMode String    @default("free_chat") // free_chat / english_story / idiom_story / sleep_story
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("conversation_sessions")
}

// 家长每日报告：使用时长和模式分布实时统计，本表保存生成内容。
model ParentReport {
  id                   String    @id @default(uuid())
  deviceId             String
  reportDate           String    // 设备当地日期 YYYY-MM-DD
  generationStatus     String    @default("pending") // pending / generating / completed / failed
  generationStartedAt  DateTime?
  generationAttempts   Int       @default(0)
  generationError      String?
  nextRetryAt          DateTime?
  expressionObservation String?
  emotionObservation   String?
  thinkingObservation  String?
  suggestion           String?
  generatorModel       String?
  promptVersion        String?
  generatedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  device   Device                   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  feedbacks ParentReportFeedback[]

  @@unique([deviceId, reportDate])
  @@map("parent_reports")
}

// 每个绑定用户对每份家长报告的独立反馈。
model ParentReportFeedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  deviceId  String   @map("device_id")
  reportDate String  @map("report_date")
  isUseful  Boolean  @map("is_useful")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  report ParentReport @relation(fields: [deviceId, reportDate], references: [deviceId, reportDate], onDelete: Cascade)

  @@unique([userId, deviceId, reportDate])
  @@index([deviceId, reportDate])
  @@map("parent_report_feedbacks")
}

// 家长端习惯培养计划，例如 21 天睡前刷牙计划。
model HabitPlan {
  id        String   @id @default(uuid())
  deviceId  String
  key       String
  title     String
  targetDays Int     @default(21)
  startDate String   // YYYY-MM-DD
  status    String   @default("active") // active / completed / archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device       Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  dailyRecords HabitDailyRecord[]

  @@unique([deviceId, key])
  @@map("habit_plans")
}

model HabitDailyRecord {
  id         String   @id @default(uuid())
  planId     String
  recordDate String   // YYYY-MM-DD
  completed  Boolean  @default(false)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan HabitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, recordDate])
  @@map("habit_daily_records")
}

// 家长与设备绑定关系（多对多）
model UserDeviceBinding {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String
  isOwner   Boolean  @default(true) // 是否为拥有者
  sortOrder Int      @default(0) // 当前用户的设备显示顺序
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, sortOrder])
  @@map("user_device_bindings")
}

// 孩子档案（与设备一对一）
model ChildProfile {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String?  @unique // 设备内部 ID，一对一
  name        String?  // 孩子姓名
  birthday    String?  // 生日 YYYY-MM-DD
  englishName String?  // 英文名（AI 称呼用）
  gender      String?  // 性别：male / female；NULL 表示未设置
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("child_profiles")
}

// 设备配置快照
model DeviceConfig {
  id                   String   @id @default(uuid())
  deviceId             String
  mode                 String   // 设备对话模式：free_chat / english_chat
  cefrLevel            String?  // CEFR 难度等级
  language             String?  // 语言：zh/en/bilingual
  speechRate           String?  // 语速：slow/normal/fast
  isActive             Boolean  @default(true) // 是否当前生效
  payload              Json?    // 扩展字段快照
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_configs")
}

// 消息（细颗粒度：一行一条消息,一轮问答由 turnId 关联两条）
model Message {
  id            String   @id @default(uuid())
  deviceId      String
  turnId        String   // 同一轮问答共享 ID（我方生成）
  role          String   // user / assistant
  content       String
  status        String   @default("completed") // assistant: completed / failed
  conversationId String? // 厂商侧对话唯一 ID（如有）
  mode                String?  // 当前配置 mode 快照
  cefrLevel           String?  // 当前配置 CEFR
  rawPayload      Json?    // Webhook 原始 payload
  spokeAt         DateTime // 消息发生时间
  createdAt       DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([conversationId, role])
  @@index([deviceId, spokeAt])
  @@index([turnId])
  @@map("messages")
}

// 学习统计（按日聚合）
model LearningStat {
  id              String   @id @default(uuid())
  deviceId        String
  statDate        String   // YYYY-MM-DD
  durationSeconds Int      @default(0) // 有效学习时长（秒）
  speakCount      Int      @default(0) // 有效开口次数
  newWords        Int      @default(0) // 当日新增单词数
  totalDurationSeconds Int @default(0) // 累计学习时长（可每日快照）
  totalSpeakCount Int      @default(0) // 累计开口次数
  totalWords      Int      @default(0) // 累计掌握单词数
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, statDate])
  @@index([deviceId, statDate])
  @@map("learning_stats")
}

// Webhook 接收日志
model WebhookLog {
  id          String   @id @default(uuid())
  source      String   // 来源标识，如 manufacturer
  eventType   String?  // 事件类型
  payload     Json     // 原始 payload
  signature   String?  // 签名
  processed   Boolean  @default(false) // 是否已处理
  idempotencyKey String? @unique // 幂等键
  errorMsg    String?  // 处理失败原因
  createdAt   DateTime @default(now())

  @@index([processed, createdAt])
  @@map("webhook_logs")
}

// 冒险故事：集元数据（主线人写定稿，见 docs/adventure-story-mode.md）
model AdventureEpisode {
  id            String   @id @default(uuid())
  characterKey  String   @default("elly") // 专属 IP：elly / polly
  season        Int      @default(1) // 季号，MVP=1
  episodeNumber Int      // 集号
  title         String   // 集标题
  recap         String?  // 前情回顾（每集开头）
  published     Boolean  @default(false) // 是否可播
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  segments  AdventureSegment[]
  progresses AdventureProgress[]
  dailyRecords AdventureDailyRecord[]
  events AdventureEvent[]

  @@unique([characterKey, season, episodeNumber])
  @@map("adventure_episodes")
}

// 冒险故事：段落/交互点切片
model AdventureSegment {
  id              String   @id @default(uuid())
  episodeId       String
  order           Int      // 集内顺序，从 0 递增
  kind            String   // narration / interaction
  text            String   // 旁白原文，或交互点引导词
  interactionType String?  // open_question / two_choice / repeat_after_me / reward
  options         Json?    // 二选一：{ choices: [{key, text, reply}] }，回应预生成
  fallbackText    String?  // 兜底话术（跑题/沉默/不配合）
  exitText        String?  // 明确拒绝时的温柔收尾
  rewardStar      Boolean  @default(false) // 通过该交互点奖励一颗星光
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  episode AdventureEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, order])
  @@map("adventure_segments")
}

// 冒险故事：每个设备、每一集的可变进度；跨天未完成仍续玩同一集。
model AdventureProgress {
  id               String    @id @default(uuid())
  deviceId         String
  episodeId        String
  nextSegmentOrder Int       @default(0) // 下一段待播 order
  status           String    // in_progress / awaiting_reply / completed / exited
  waitingSince     DateTime? // 引导词最后一个 chunk ack 的服务器时间（10s 超时起点）
  stars            Int       @default(0) // 本集已收集星光
  offTopicCount    Int       @default(0) // 当前交互点连续跑题次数（引回一次后兜底）
  completedAt      DateTime? // 实际完集时间
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  device  Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  episode AdventureEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([deviceId, episodeId])
  @@index([status, waitingSince])
  @@index([deviceId, status, completedAt])
  @@map("adventure_progresses")
}

// 冒险故事：每日分配档案。assignedDate 不变，completedDate 记录实际完集日。
model AdventureDailyRecord {
  id            String    @id @default(uuid())
  deviceId      String
  episodeId     String
  assignedDate  String    // 首次分配日（服务器本地时区）
  status        String    // in_progress / completed
  assignedAt    DateTime  @default(now())
  completedAt   DateTime?
  completedDate String?   // 实际完集日；每日完成门禁以此字段判断
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  device  Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  episode AdventureEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  events  AdventureEvent[]

  @@unique([deviceId, assignedDate])
  @@index([deviceId, completedDate])
  @@index([deviceId, status])
  @@map("adventure_daily_records")
}

// 冒险故事：不可变审计事件；全文仍在 Message，避免重复保存 ASR/播报文本。
model AdventureEvent {
  id            String   @id @default(uuid())
  eventKey      String   @unique // 幂等键，如 daily:{dailyId}:completed
  deviceId      String
  episodeId     String
  dailyRecordId String
  turnId        String?
  eventType     String
  segmentOrder  Int?
  payload       Json?
  createdAt     DateTime @default(now())

  device      Device               @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  episode     AdventureEpisode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  dailyRecord AdventureDailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@index([dailyRecordId, createdAt])
  @@map("adventure_events")
}

// 儿童长期记忆：值不可覆盖；纠正通过新版本保留历史。
model ChildMemory {
  id               String    @id @default(uuid())
  deviceId         String
  key              String    // 代码白名单槽位，如 favorite_color
  valueText        String?   // 撤回墓碑为 null
  normalizedValue  String?
  changeType       String    // initial / supersede / retract
  status           String    // active / superseded / retracted
  version          Int
  sourceTurnId     String
  sourceOccurredAt DateTime
  confidence       Float
  extractorModel   String
  validFrom        DateTime
  validTo          DateTime?
  supersededById   String?
  lastConfirmedAt  DateTime
  lastInjectedAt   DateTime? // 提供给模型的时间，不代表孩子已听到
  injectionCount   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, key, version])
  @@unique([deviceId, sourceTurnId, key])
  @@index([deviceId, status, key, lastInjectedAt])
  @@index([deviceId, key, validFrom])
  @@map("child_memories")
}

// 哄睡配置：每设备一份，生命周期跟随设备（级联删除）
model SleepConfig {
  id              String   @id @default(uuid())
  deviceId        String   @unique // 设备内部 ID，一对一
  enabled         Boolean  @default(false) // 哄睡总开关
  durationMode    String   @default("default") // default=后端决定时长 / custom=手动
  durationMinutes Int? // custom 时必填：10/15/20/25/30；default 时恒为 null
  contentType     String   @default("story") // story / song / mixed
  sleepTime       String   @default("21:30") // 每晚定时进入时间，HH:mm（24h）
  forceSleep      Boolean  @default(false) // 强制哄睡开关
  lastTriggeredDate String? // 定时进入最后触发日期（北京时区 YYYY-MM-DD），每天最多一次
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("sleep_configs")
}

// LLM 调用日志（主模型 + 小模型全量），模型监控页数据源
model LlmUsageLog {
  id               String   @id @default(uuid())
  scene            String   // safety_l2 / intent_classify / filler / adventure_interaction
                            // / memory_extract / sleep_config_extract / sleep_story_generate
                            // / chat_main / parent_report
  model            String   // 实际模型名，如 qwen-flash / deepseek-flash
  tier             String   // small / main（冗余字段，查询方便）
  success          Boolean
  failureReason    String?  // timeout / rate_limit / parse_error / upstream_error / empty_response
  failureDetail    String?  @db.VarChar(200) // 失败细节紧凑串：HTTP 400: {...} / ECONNRESET: socket hang up
  latencyMs        Int?     // 请求发出 → 完整响应（流式为末 chunk）的总耗时
  firstTokenMs     Int?     // 首包时间：请求发出 → 首个 chunk；仅流式调用有值，非流式恒 null
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  cacheHitInputTokens Int?   // 上游回传的缓存命中输入 token；DeepSeek=prompt_cache_hit_tokens，
                             // DashScope=prompt_tokens_details.cached_tokens；未回传=null（成本退化为上界）
  costMicroCny     Int?      // 写库时按当时定价快照的估算成本，1 元 = 1_000_000；
                             // token 缺失或模型未定价=null（聚合时不计入，接口另报未计价条数）
  deviceId         String?  // FK → devices.id，可空（后台任务无设备上下文）
  turnId           String?  @map("turn_id") // 对话轮次 ID；后台任务无轮次上下文时为空
  createdAt        DateTime @default(now())

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([createdAt, scene])
  @@index([scene, success, createdAt])
  @@index([turnId])
  @@map("llm_usage_logs")
}

/// 阿里云 BSS 真实账单按日落库：小模型（qwen-flash / 百炼）金额以此为真值，
/// 主模型（deepseek-flash）金额由 llm_usage_logs 估算，两者在接口层合并。
/// 金额统一 micro-CNY（1 元 = 1_000_000）：与 llm_usage_logs.costMicroCny 同单位，
/// 聚合即 SUM(Int)，出参是 number，不引入 Decimal 的字符串序列化问题。
model LlmCostDaily {
  id                   String   @id @default(uuid())
  billDate             String   // YYYY-MM-DD；取响应 Items[].BillingDate，不用请求参数
                                // （BillingDate 与 BillingCycle 月份不一致时官方按 BillingCycle 返回整月数据）
  billingCycle         String   // YYYY-MM；BSS 必填参数，由 billDate 推导
  provider             String   @default("aliyun")
  productCode          String
  productName          String?
  billingItem          String
  billingItemCode      String   @default("")
  instanceId           String   @default("")
  model                String   @default("unknown") // 从 billingItem / instanceId 解析；解析不出为 unknown
  tier                 String   @default("small")   // small / main / unknown，按 model 名映射而非埋点 tier
  itemKind             String   // PayAsYouGoBill / Refund / Adjustment / SubscriptionOrder；退款调账金额为负
  subscriptionType     String   @default("PayAsYouGo")
  usage                Int?     // Items[].Usage（官方为 string，且是周期内累加语义，不可当 token 真值）
  usageUnit            String?
  grossMicroCny        Int      // PretaxGrossAmount 原价
  payableMicroCny      Int      // PretaxAmount 应付（页面默认口径）
  cashMicroCny         Int      @default(0) // PaymentAmount 现金支付
  resourcePackMicroCny Int      @default(0) // DeductedByResourcePackage 资源包抵扣
  couponMicroCny       Int      @default(0) // DeductedByCashCoupons 代金券抵扣
  currency             String   @default("CNY")
  settled              Boolean  @default(false) // 终账（次月 3 日 12 点后）；false 时页面标「暂估」
  dedupeKey            String   @unique // 幂等键：全部可区分维度拼接，列非空故 upsert 的 ON CONFLICT 生效
                                        // （可空列参与唯一键时 PG 视 NULL 互不相等，会每次同步插重复行）
  fetchedAt            DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([billDate])
  @@index([billDate, tier])
  @@map("llm_cost_daily")
}

/// 小程序订阅消息额度池（路 B：一次性订阅 + 静默补额）。
/// 额度语义：用户每次 accept（含「不再询问」后的静默 accept）+N，发送成功 -1；
/// 无官方额度查询接口，本表为服务端账本，43101 时兜底清零。
/// 发送时按当前绑定关系找人：解绑/wipe 后不再触达，无需按设备清理本表。
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  templateId String // 微信订阅消息模板 ID
  quota      Int      @default(0) // 剩余可发送条数
  status     String   @default("active") // active / rejected / exhausted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@map("push_subscriptions")
}

/// 对话轮次的「判定质量」审计表：安全拦截（L1/L2）与意图路由的决策来源逐轮落库。
/// 与 llm_usage_logs 的分工：那张表记「模型调用是否健康」，本表记「模型的判定是否可信」——
/// 判为 safe、标签非法、模型失败开放放行三者必须可区分，否则拦截率与漏放率都算不出来。
/// 明细永久保留（安全审计与申诉回溯需要），不设 TTL、不做预聚合表。
model TurnDecisionLog {
  id             String    @id @default(uuid())
  turnId         String    @unique // 一轮一行；upsert 幂等，防主模型重试写重复行
  deviceId       String?   // 刻意不设 FK：安全审计要保留设备标识，不随设备 wipe 级联删除
  channel        String    @default("baidu-rtc") // 本期恒为 baidu-rtc；老 WS 链路不埋点，留列以备接入
  safetyLayer    String?   // L1 / L2 / null（未评估或模型异常）
  safetyCategory String?   // safe / sexual / violence / self_harm / emotional_harm / null
  safetyBlocked  Boolean   @default(false)
  safetySource   String    @default("none") // l1_regex / l2_model / l2_invalid_label / l2_fail_open / not_evaluated
  safetyMatched  String?   @db.VarChar(64) // L1 命中的规则关键词，便于复核规则误伤
  intent         String?   // 七标签之一；被安全拦截时未走到路由为 null
  intentSource   String?   // model / fallback_invalid_label / fallback_error / pre_filter_skip
                           // / continuation / session_sticky / explicit_exit
                           // / adventure_takeover（冒险接管，L2 未评估）/ not_routed（被拦截）
  asrText        String?   @db.VarChar(200) // 仅 blocked 或类别非 safe 时写；儿童语音转写，禁入日志
  reviewLabel    String?   // TODO(二期·人工复核闭环)：复核结论 correct / false_positive / missed；
                           // 本期只建列、不提供写接口，看板复核队列为只读
  reviewedAt     DateTime? // TODO(二期·人工复核闭环)：与 reviewLabel 同步写入
  createdAt      DateTime  @default(now())

  @@index([createdAt, safetyCategory])
  @@index([createdAt, intent, intentSource])
  @@index([createdAt, safetySource])
  @@map("turn_decision_logs")
}

// 设备在线上报日落库：MQTT 心跳旁路，内存聚合 5 分钟批量 flush
model DevicePresenceDaily {
  id          String   @id @default(uuid())
  deviceId    String // Device.id（内部 UUID），非业务 MAC
  date        String // YYYY-MM-DD，Asia/Shanghai 自然日
  reportCount Int      @default(0) // 当日心跳次数（5 分钟粒度聚合累加）
  firstSeenAt DateTime // 当日首次上报
  lastSeenAt  DateTime // 当日最后上报
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, date])
  @@index([date])
  @@map("device_presence_daily")
}

/// 可编辑 prompt 注册表：当前生效指针 + 展示元信息。
/// 代码内 PROMPT_DEFAULTS（prompt-defaults.ts）是 fail-safe 兜底：
/// publishedRevision 为 null、DB 不可用、渲染失败，一律回落代码默认值，
/// 产品行为退化为「注册表上线前」。首次部署只建 draft 不自动 publish，
/// 因此上线当天全部走代码默认值，行为零变化。
/// renderSchema 是变量契约的展示快照，渲染时一律以代码为准（防 admin 改契约）。
model PromptTemplate {
  id                String    @id @default(uuid())
  key               String    @unique // 业务键，与代码 PROMPT_KEYS 一一对应，禁止删行
  category          String // small_model / main_rules / story / persona
  scene             String? // 关联 LLM_SCENES；人设等无单一场景的为 null
  name              String // 中文展示名
  description       String? // 用途与影响面说明，dashboard 上给 admin 看
  renderSchema      Json? // 变量契约快照 [{name,required,description}]，仅展示用
  draftRevision     Int? // 未发布草稿的版本号；null = 无草稿
  publishedRevision Int? // 当前生效版本号；null = 未发布，运行时走代码默认值
  publishedAt       DateTime?
  publishedBy       String? // admin username
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  versions PromptTemplateVersion[]

  @@map("prompt_templates")
}

/// prompt 版本链，同时充当审计日志（谁、何时、改了什么、为什么）。
/// 不额外建审计表：本表已是完整审计链。
/// 状态由 PromptTemplate 的两个指针派生，不存 status 枚举，避免指针与状态漂移：
/// revision == draftRevision 是草稿，== publishedRevision 是生效版本，其余是历史。
/// 回滚 = 以目标版本内容创建新 revision 并直接发布（同 git revert），
/// revision 恒单调递增，不做时间倒流的状态回改。
model PromptTemplateVersion {
  id                String    @id @default(uuid())
  templateId        String
  revision          Int // 同一 template 内单调递增
  content           String    @db.Text
  changeNote        String? // 发布说明，publish/rollback 时必填
  authorUsername    String
  authorDisplayName String?
  createdAt         DateTime  @default(now())
  publishedAt       DateTime?

  template PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, revision])
  @@map("prompt_template_versions")
}
